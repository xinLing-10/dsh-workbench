# Publish only the plugin bundles and repository documentation.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/dsh-workbench/
!/spec-analyst-preset/
!/stage-presets/
!/deploy/
!/services/
!/packages/
!/apps/
!/fixtures/
!/.dockerignore

**/.DS_Store
**/node_modules/
**/.dsh/
**/.env
**/.env.*
**/control-data/
!**/.env.example
**/*.log
**/*.pem
**/*.key

**/__pycache__/
/deploy/instances/
/deploy/backups/
