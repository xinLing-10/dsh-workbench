# Install only after replacing the three placeholders and verifying certificate paths.
# Each user needs a separate hostname and an independent DSH instance.
server {
    listen 443 ssl;
    server_name USER_HOSTNAME;
    ssl_certificate /etc/letsencrypt/live/USER_HOSTNAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/USER_HOSTNAME/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 50m;
    # Do not log launch-token query strings.
    access_log off;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    location / {
        proxy_pass http://127.0.0.1:INSTANCE_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_cookie_path / "/; Secure; SameSite=Lax";
    }
}
