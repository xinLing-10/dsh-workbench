[Unit]
Description=Read-only manager acceptance observation (no model calls)
After=manager-acceptance-api.service manager-acceptance-worker.service
[Service]
Type=oneshot
User=manager-acceptance
Group=manager-acceptance
WorkingDirectory=/srv/manager-acceptance/release
ExecStart=/srv/manager-acceptance/runtime/node deploy/service/observe.mjs sample /srv/manager-acceptance/private/observe.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/manager-acceptance/observation
UMask=0077
